# Copie este archivo como .env y ajuste los valores antes de ejecutar
#   docker compose up --build
# El archivo .env está en .gitignore: las credenciales no se suben al repositorio.

DB_NAME=proyecto_db
DB_USERNAME=proyecto_user
DB_PASSWORD=cambie-esta-clave

# Puertos publicados en su máquina
FRONTEND_PORT=4200
BACKEND_PORT=8080
DB_PORT=5432
