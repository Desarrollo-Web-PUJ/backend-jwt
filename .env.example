# Copie este archivo como .env y ajuste los valores antes de ejecutar
#   docker compose up --build
# El archivo .env está en .gitignore: las credenciales no se suben al repositorio.

DB_NAME=proyecto_db
DB_USERNAME=proyecto_user
DB_PASSWORD=cambie-esta-clave

# Clave para firmar los JWT: mínimo 32 caracteres, distinta en cada ambiente
JWT_SECRET=cambie-esta-clave-por-una-de-al-menos-32-caracteres
JWT_EXPIRACION_MINUTOS=60

# Puertos publicados en su máquina
FRONTEND_PORT=4200
BACKEND_PORT=8080
WEB_PORT=8090
DB_PORT=5432
