{
  "info": {
    "name": "Editor de procesos - API REST",
    "description": "Recorre la API completa en orden: registra una empresa, inicia sesión y modela el proceso de solicitud de vacaciones del enunciado. Ejecútela con el Collection Runner (en orden). Postman conserva la cookie JSESSIONID entre peticiones.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "1. Empresas y sesión (HU-01 a HU-03)",
      "item": [
        {
          "name": "Registrar empresa",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/empresas/registro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "empresas",
                "registro"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Empresa Demo {{sufijo}}\",\n  \"nit\": \"900{{sufijo}}\",\n  \"correoContacto\": \"contacto{{sufijo}}@demo.com\",\n  \"adminNombre\": \"Ana Administradora\",\n  \"adminCorreo\": \"admin{{sufijo}}@demo.com\",\n  \"adminPassword\": \"Clave12345\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201', () => pm.response.to.have.status(201));",
                  "pm.test('Devuelve el administrador inicial', () => pm.expect(pm.response.json().adminUsuarioId).to.be.a('number'));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('sufijo', Date.now().toString());"
